{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "transactionId": {
      "type": "string",
      "minLength": 1
    },
    "packageVersion": {
      "type": "string",
      "minLength": 1
    },
    "projectRoot": {
      "type": "string",
      "minLength": 1
    },
    "hosts": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "codex",
          "claude"
        ]
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relativePath": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "enum": [
              "create",
              "update",
              "unchanged",
              "remove"
            ]
          },
          "beforeHash": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "afterHash": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "originalBase64": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "ownedAfter": {
            "type": "boolean"
          }
        },
        "required": [
          "relativePath",
          "action",
          "beforeHash",
          "afterHash",
          "content",
          "originalBase64",
          "ownedAfter"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "transactionId",
    "packageVersion",
    "projectRoot",
    "hosts",
    "changes"
  ],
  "additionalProperties": false
}
