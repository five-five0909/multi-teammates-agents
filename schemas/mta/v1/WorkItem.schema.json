{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "read",
        "write",
        "verify"
      ]
    },
    "required": {
      "type": "boolean"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ownership": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "executor_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "attempt": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "default": "pending",
      "type": "string",
      "enum": [
        "pending",
        "running",
        "submitted",
        "auditing",
        "accepted",
        "rework",
        "blocked",
        "cancelled"
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "objective",
    "role",
    "mode",
    "required",
    "depends_on",
    "ownership",
    "evidence_required",
    "attempt",
    "status"
  ],
  "additionalProperties": false
}
