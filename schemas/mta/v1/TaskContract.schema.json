{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "goal": {
      "type": "string"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deliverables": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "goal",
    "constraints",
    "deliverables",
    "acceptance_criteria"
  ],
  "additionalProperties": false
}
