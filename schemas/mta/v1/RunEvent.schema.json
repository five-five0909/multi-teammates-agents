      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "expected_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "kind": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "payload": {
