{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "run_id": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "initialized",
        "managing",
        "executing_wave",
        "auditing_wave",
        "needs_input",
        "blocked",
        "proposed_complete",
        "completed",
        "cancelled"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "last_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "contract": {
      "$ref": "#/$defs/TaskContract"
    },
    "work_items": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/WorkItem"
      }
    },
    "verified_progress": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "event_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pending_gate": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "rounds_used": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "max_rounds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "retry_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "state",
    "version",
    "last_seq",
    "contract",
    "work_items",
    "verified_progress",
    "event_ids",
    "pending_gate",
    "rounds_used",
    "max_rounds",
    "retry_limit"
  ],
  "additionalProperties": false,
  "$defs": {
    "TaskContract": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number",
          "const": 1
        },
        "goal": {
          "type": "string"
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deliverables": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptance_criteria": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "schema_version",
        "goal",
        "constraints",
        "deliverables",
        "acceptance_criteria"
      ],
      "additionalProperties": false
    },
    "WorkItem": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number",
          "const": 1
        },
        "id": {
          "type": "string"
        },
        "objective": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "read",
            "write",
            "verify"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ownership": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "executor_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "attempt": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "status": {
          "default": "pending",
          "type": "string",
          "enum": [
            "pending",
            "running",
            "submitted",
            "auditing",
            "accepted",
            "rework",
            "blocked",
            "cancelled"
          ]
        }
      },
      "required": [
        "schema_version",
        "id",
        "objective",
        "role",
        "mode",
        "required",
        "depends_on",
        "ownership",
        "evidence_required",
        "attempt",
        "status"
      ],
      "additionalProperties": false
    }
  }
}
