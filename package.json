{
  "name": "multi-teammates-agents",
  "version": "0.5.0-alpha.2",
  "description": "Project-scoped AI harness for Trellis-governed, audited long-horizon work",
  "type": "module",
  "bin": {
    "mta": "bin/mta.js",
    "multi-teammates-agents": "bin/mta.js"
  },
  "files": [
    "bin/",
    "dist/",
    "schemas/mta/",
    "skills/expert-team/",
    "agents/",
    "README.md",
    "README_zh.md",
    "docs/npm-only-control-plane.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test bin scripts/npm-install-smoke.mjs",
    "test": "npm run build && node --test \"test/**/*.test.mjs\"",
    "schemas:generate": "npm run build && node dist/runtime/core/generate-schemas.js",
    "pack:check": "npm pack --dry-run --json",
    "smoke:install": "npm run build && node scripts/npm-install-smoke.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/five-five0909/multi-teammates-agents.git"
  },
  "keywords": [
    "ai-agent",
    "codex",
    "claude-code",
    "trellis",
    "long-horizon"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0"
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
